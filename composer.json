{
    "name": "omega-mvc/gettext",
    "type": "library",
    "description": "GNU gettext-based localization and translation support for the Omega ecosystem, providing message translation management and internationalization services.",
    "keywords": ["js", "gettext", "i18n", "translation", "po", "mo"],
    "homepage": "https://omega-mvc.github.io",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Adriano Giovannini",
            "email": "agisoftt@gmail.com",
            "homepage": "http://omega-mvc.github.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "nikic/php-parser": "^v5.6.1",
        "mck89/peast": "^1.16.3-dev"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "tomasvotruba/type-coverage": "^2.5",
        "phpunit/php-code-coverage": "dev-omega as 14.3.1"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/omega-mvc/php-code-coverage"
        }
    ],
    "autoload": {
        "psr-4": {
            "Omega\\Gettext\\": "src/Omega/Gettext"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Tests\\": "tests/Tests"
        }
    },
    "scripts": {
        "phpcs": "XDEBUG_MODE=off php vendor/bin/phpcs",
        "phpcbf": "XDEBUG_MODE=off php vendor/bin/phpcbf --standard=PSR12",
        "phpstan": "XDEBUG_MODE=off php vendor/bin/phpstan analyze -vvv",
        "type-coverage": "XDEBUG_MODE=off php vendor/bin/phpstan analyze --no-progress",
        "test-no-coverage": "XDEBUG_MODE=off php vendor/bin/phpunit --no-coverage",
        "test": "XDEBUG_MODE=coverage php vendor/bin/phpunit"
    }
}

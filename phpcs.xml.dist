<?xml version="1.0"?>
<ruleset name="omega-mvc-gettext">
    <description>Full PSR-12 coding standard for omega-mvc/gettext.</description>
    <arg name="cache" value="cache/phpcs/phpcs.json"/>
    <arg name="parallel" value="4"/>

    <rule ref="PSR12"/>

    <file>src</file>
    <file>tests</file>

    <!-- Vendored gettext/languages subpackage: deprecation fixes only, never restyled.
         NOTE: no <exclude-pattern>vendor/*</exclude-pattern> here. Because this package
         can be checked out nested inside another project's vendor/ directory (e.g. the
         omega-mvc/omega starter), a relative 'vendor/*' pattern matches that enclosing
         vendor/ path too, excluding EVERY file. The vendor dir is not scanned anyway
         since only src and tests are listed as <file> roots. -->
    <exclude-pattern>src/Omega/Gettext/Languages/*</exclude-pattern>

    <!-- PHP 8.4 property hooks: PHPCS 4.x cannot tokenize hook syntax. -->
    <rule ref="PSR2.Classes.PropertyDeclaration">
        <exclude-pattern>src/Omega/Gettext/Translation.php</exclude-pattern>
        <exclude-pattern>src/Omega/Gettext/Translations.php</exclude-pattern>
    </rule>

    <!-- NEVER reformat: scanner fixtures assert exact line numbers and comment
         shapes; data.php is regenerated on every test run (machine output,
         never a lint target). -->
    <exclude-pattern>tests/Tests/Gettext/assets/*</exclude-pattern>
    <exclude-pattern>tests/data.php</exclude-pattern>
    <exclude-pattern>tests/data.json</exclude-pattern>
    <rule ref="PSR1.Files.SideEffects">
        <!-- Procedural test bootstrap by design. -->
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
</ruleset>

parameters:
    level: 10
    tmpDir: cache/phpstan
    bootstrapFiles:
        - tests/constants.php
    paths:
        - src
        - tests
    excludePaths:
        # Vendored gettext/languages subpackage: out of scope for static analysis.
        - src/Omega/Gettext/Languages
        # Scanner fixtures: intentionally unstyled code whose line numbers and
        # comment shapes are asserted by tests. Never analyse or restyle.
        - tests/Tests/Gettext/assets
